digraph GreenGridJoinFlow {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.30", nodesep="0.32", ranksep="0.55", splines=ortho, fontname="Arial", labelloc="t", label="GREENGRID ENERGY | DATA JOIN & OPERATIONAL KPI PIPELINE", fontsize=22, fontcolor="#16324F"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.12,0.08", color="#66839B", penwidth=1.15, fontcolor="#17324D"];
  edge [fontname="Arial", fontsize=8.5, color="#58738A", penwidth=1.1, arrowsize=0.7];

  subgraph cluster_sources {
    label="CLEANED SOURCE FILES  |  join each table at its own grain";
    fontsize=13; fontname="Arial"; fontcolor="#315B72"; color="#B8CCD8"; style="rounded"; bgcolor="#F7FAFC";
    assets [fillcolor="#E4EEF8", label=<<B>asset_registry_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: 1 row / asset</FONT><BR/><FONT POINT-SIZE="9">Key: asset_id</FONT>>];
    scada [fillcolor="#E4EEF8", label=<<B>scada_generation_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: asset × hour</FONT><BR/><FONT POINT-SIZE="9">Key: asset_id + timestamp</FONT>>];
    weather [fillcolor="#E7F4E8", label=<<B>weather_station_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: station × hour</FONT><BR/><FONT POINT-SIZE="9">Key: station_id + timestamp</FONT>>];
    mapping [fillcolor="#F1EAFE", label=<<B>asset_weather_mapping.csv</B> <FONT POINT-SIZE="9">(optional if 1 station only)</FONT><BR/><FONT POINT-SIZE="9">Maps asset_id → station_id</FONT>>];
    ems [fillcolor="#FFF1D6", label=<<B>ems_operations_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: 1 row / hour</FONT><BR/><FONT POINT-SIZE="9">Demand + export limits</FONT>>];
    bess [fillcolor="#FFF1D6", label=<<B>bess_operations_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: region × hour</FONT><BR/><FONT POINT-SIZE="9">Charge / discharge / capacity</FONT>>];
    market [fillcolor="#FCE7F3", label=<<B>market_price_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: 1 row / hour</FONT><BR/><FONT POINT-SIZE="9">Key: timestamp</FONT>>];
    dispatch [fillcolor="#FCE7F3", label=<<B>dispatch_curtailment_log_clean.csv</B><BR/><FONT POINT-SIZE="9">Grain: 1 row / event</FONT><BR/><FONT POINT-SIZE="9">region + start_time + end_time</FONT>>];
    {rank=same; assets; scada; weather; mapping;}
    {rank=same; ems; bess; market; dispatch;}
    assets -> scada [style=invis, weight=4]; scada -> weather [style=invis, weight=4]; weather -> mapping [style=invis, weight=4];
    ems -> bess [style=invis, weight=4]; bess -> market [style=invis, weight=4]; market -> dispatch [style=invis, weight=4];
  }

  base [fillcolor="#DDEBFA", color="#4D7EA8", penwidth=1.5, label=<<B>1. BUILD ASSET-HOUR BASE</B><BR/><FONT POINT-SIZE="9">SCADA LEFT JOIN registry</FONT><BR/><FONT POINT-SIZE="9">ON asset_id · many-to-one</FONT>>];
  wxjoin [fillcolor="#E2F2E5", color="#50945D", label=<<B>2. MAP WEATHER TO ASSETS</B><BR/><FONT POINT-SIZE="9">Mapping assigns station_id to each asset</FONT><BR/><FONT POINT-SIZE="9">Join on timestamp + asset_id</FONT><BR/><FONT POINT-SIZE="9">Never join weather by timestamp alone</FONT>>];
  potential [fillcolor="#DDEBFA", color="#4D7EA8", label=<<B>3. ESTIMATE POTENTIAL GENERATION</B><BR/><FONT POINT-SIZE="9">Weather + capacity + availability</FONT><BR/><FONT POINT-SIZE="9">Potential is modeled, not metered</FONT>>];
  regional [fillcolor="#FFF0CE", color="#C28A24", penwidth=1.5, label=<<B>4. BUILD REGIONAL-HOUR MODEL</B><BR/><FONT POINT-SIZE="9">Aggregate potential by timestamp + region</FONT><BR/><FONT POINT-SIZE="9">EMS expanded to North/Central</FONT><BR/><FONT POINT-SIZE="9">Join EMS + BESS on timestamp + region</FONT><BR/><FONT POINT-SIZE="9">Calculate absorption capacity, modeled output and curtailment</FONT>>];
  dispatchhour [fillcolor="#FBE8F1", color="#B95A89", label=<<B>5. ENRICH REGIONAL KPIs WITH EVENTS</B><BR/><FONT POINT-SIZE="9">Expand each event start–end to hourly rows</FONT><BR/><FONT POINT-SIZE="9">Aggregate by timestamp + region</FONT><BR/><FONT POINT-SIZE="9">Append event metadata after model calculations</FONT>>];
  alloc [fillcolor="#DDEBFA", color="#4D7EA8", penwidth=1.5, label=<<B>6. ALLOCATE REGIONAL CURTAILMENT</B><BR/><FONT POINT-SIZE="9">Join regional model back to asset-hour</FONT><BR/><FONT POINT-SIZE="9">ON timestamp + region · many-to-one</FONT><BR/><FONT POINT-SIZE="9">Allocate by each asset's share of potential generation</FONT>>];
  system [fillcolor="#FCE7F3", color="#B95A89", penwidth=1.5, label=<<B>7. CALCULATE SYSTEM + MARKET KPIs</B><BR/><FONT POINT-SIZE="9">Aggregate asset-hour to one row / hour</FONT><BR/><FONT POINT-SIZE="9">Join EMS and market price on timestamp</FONT><BR/><FONT POINT-SIZE="9">Calculate surplus, renewable share, curtailment value proxies</FONT>>];

  out_asset [shape=folder, fillcolor="#DDEBFA", color="#4D7EA8", penwidth=1.5, label=<<B>OUTPUT A</B><BR/><B>greengrid_asset_hour_analysis.csv</B><BR/><FONT POINT-SIZE="9">Grain: asset × hour</FONT><FONT POINT-SIZE="9"><BR/>Detailed asset + regional + system/market metrics</FONT>>];
  out_region [shape=folder, fillcolor="#FFF0CE", color="#C28A24", penwidth=1.5, label=<<B>OUTPUT B</B><BR/><B>greengrid_regional_hourly_kpis.csv</B><BR/><FONT POINT-SIZE="9">Grain: region × hour</FONT><FONT POINT-SIZE="9"><BR/>Regional generation, BESS, curtailment, events</FONT>>];
  out_system [shape=folder, fillcolor="#FCE7F3", color="#B95A89", penwidth=1.5, label=<<B>OUTPUT C</B><BR/><B>greengrid_system_hourly_kpis.csv</B><BR/><FONT POINT-SIZE="9">Grain: 1 row / hour</FONT><FONT POINT-SIZE="9"><BR/>System metrics + market price metrics</FONT>>];

  scada -> base [label="source rows"];
  assets -> base [label="asset_id"];
  base -> wxjoin;
  weather -> wxjoin [label="station_id + timestamp"];
  mapping -> wxjoin [label="asset ↔ station"];
  wxjoin -> potential;
  potential -> regional [label="aggregate by timestamp + region"];
  ems -> regional [label="timestamp; split into region-hour"];
  bess -> regional [label="timestamp + region"];
  regional -> dispatchhour [style=dashed, label="append metadata after regional calculations"];
  dispatch -> dispatchhour [label="event window + region"];
  regional -> alloc [label="regional curtailment"];
  potential -> alloc [label="asset potential share"];
  dispatchhour -> out_region [label="regional KPIs + event fields"];
  alloc -> system [label="aggregate by timestamp"];
  ems -> system [label="timestamp"];
  market -> system [label="timestamp"];
  alloc -> out_asset;
  dispatchhour -> out_asset [label="region-hour event fields"];
  system -> out_asset [label="timestamp-level KPIs"];
  system -> out_system;

  {rank=same; out_asset; out_region; out_system;}
}
