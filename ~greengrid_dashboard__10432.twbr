      <aliases enabled='yes' />
      <column caption='potensial_generation' datatype='real' name='[Calculation_0112205489291264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[capacity_mw] * ([availability_pct]/100) * &#13;&#10;(IF [technology] == &quot;SOLAR PV&quot;&#13;&#10;    THEN [solar_capacity_factor]&#13;&#10;ELSEIF [technology] == &quot;WIND&quot;&#13;&#10;    THEN [wind_capacity_factor]&#13;&#10;END)' />
      </column>
      <column caption='absorption_capacity' datatype='real' name='[Calculation_0716937184198656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [region] == &quot;NORTH&quot;&#13;&#10;    THEN [north_demand_mwh] + [north_export_limit_mw] + [charge_mwh]&#13;&#10;ELSEIF [region] == &quot;CENTRAL&quot;&#13;&#10;    THEN [central_demand_mwh] + [central_export_limit_mw] + [charge_mwh]&#13;&#10;END' />
      </column>
